# Public site address, used for canonical URLs, social share images and the sitemap.
# Falls back to the Vercel production URL, then to localhost.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Firebase, from the Firebase console: Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local testing only: use the Firebase Auth Emulator, for example http://127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Flutterwave (for wallet funding and withdrawals)
# Get these from: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret hash for verifying webhooks, set in Flutterwave dashboard > Settings > Webhooks
FLUTTERWAVE_WEBHOOK_HASH=
# Where Flutterwave redirects after payment (optional, defaults to /dashboard/wallet)
FLUTTERWAVE_REDIRECT_URL=https://your-domain.example/dashboard/wallet
# Where Flutterwave sends transfer/payment webhooks (optional, defaults to /api/webhooks/flutterwave)
FLUTTERWAVE_WEBHOOK_URL=https://your-domain.example/api/webhooks/flutterwave
# Encryption key for card payments (from Flutterwave dashboard)
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
